# Copy to .env (never commit .env). Development defaults only.
POSTGRES_USER=sie
POSTGRES_PASSWORD=sie_dev_only
POSTGRES_DB=sie
POSTGRES_PORT=5432
DATABASE_URL=postgresql+psycopg://sie:sie_dev_only@127.0.0.1:5432/sie

# Optional overrides (all prefixed SIE_)
# SIE_ENV=dev                      # dev | test | prod (prod requires the two secrets below)
# SIE_LOG_LEVEL=INFO
# SIE_LOG_JSON=true
# SIE_TENANT_ID=default
# SIE_DATA_REGION=UZ
# SIE_PROVIDERS_FILE=config/providers.yaml   # model-provider allow-list (copy providers.example.yaml)
# SIE_TEST_DATABASE_URL=                     # database for integration tests

# Compliance (TZ section 2): sessions and secrets stay out of the repo.
# SIE_HMAC_SECRET=
# SIE_SESSION_ENCRYPTION_KEY=
# TELEGRAM_API_ID=
# TELEGRAM_API_HASH=
